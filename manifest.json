{
  "name": "Spotibits (Web)",
  "short_name": "Spotibits",
  "version": "0.3.0",
  "description": "Shows which audio quality Spotify Web Player streams, with an on/off switch in the extension icon.",
  "manifest_version": 3,
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Spotibits",
    "default_popup": "src/options.html"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
